# Environment Configuration for AutoML Analyst AI

# Google Gemini API Key (optional for ML features, required for AI Analyst summaries & chat)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Port (Render sets this dynamically via $PORT)
PORT=8000

# Frontend environment variable (Render sets this automatically from the backend service in render.yaml)
# VITE_BACKEND_URL=https://your-backend-service.onrender.com
